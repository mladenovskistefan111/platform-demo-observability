// ------------------------------------------------------------
// Grafana Alloy configuration
// Receives traces, scrapes metrics, collects logs
// Forwards everything to Mimir, Loki, Tempo, Pyroscope
// ------------------------------------------------------------


// --- OTLP receiver (traces + metrics from all services) ---
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// --- Forward traces to Tempo ---
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// --- Bridge OTLP metrics to Prometheus remote_write ---
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Scrape metrics from frontend ---
prometheus.scrape "frontend" {
  targets = [
    {"__address__" = "frontend:9464", "job" = "frontend"},
  ]
  forward_to = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
}

// --- Scrape metrics from ad-service ---
prometheus.scrape "ad" {
  targets = [
    {"__address__" = "ad-service:9464", "job" = "ad-service"},
  ]
  forward_to = [prometheus.remote_write.mimir.receiver]
